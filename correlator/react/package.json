{
  "name": "@sideways-works/react-correlator",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Records who uses and who runs the units of a TypeScript, JavaScript and CSS frontend: links between them and to npm packages, and the units each browser test ran.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot 'test/**/*.test.ts'",
    "lint": "biome check . && tsc --noEmit -p .",
    "build": "node build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@sideways-works/ts-sbom": "0.1.2",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "rolldown": "1.2.13",
    "source-map-js": "1.2.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "exports": {
    "./playwright": {
      "types": "./src/playwright.ts",
      "default": "./dist/playwright.mjs"
    }
  },
  "files": [
    "src",
    "dist/playwright.mjs",
    "build.ts"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "error"
    }
  },
  "pipelinegen": {
    "release": [
      "dist/playwright.mjs"
    ],
    "notice": [
      {
        "entryPoints": [
          "src/cli.ts"
        ],
        "format": "cjs",
        "srcAlias": {
          "@sideways-works/ts-sbom": "../../node_modules/@sideways-works/ts-sbom/src"
        }
      },
      {
        "entryPoints": [
          "src/main.ts"
        ],
        "format": "esm",
        "srcAlias": {
          "@sideways-works/ts-sbom": "../../node_modules/@sideways-works/ts-sbom/src"
        }
      },
      {
        "entryPoints": [
          "src/playwright.ts"
        ],
        "format": "esm",
        "external": [
          "@playwright/test"
        ]
      }
    ]
  }
}
